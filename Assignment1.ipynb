
students = {}

while True:
    print("\n--- Student Data Management ---")
    print("1. Add student")
    print("2. Delete student")
    print("3. Update student")
    print("4. Display all students")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        roll_no = input("Enter roll number: ")
        name = input("Enter name: ")
        branch = input("Enter branch: ")
        marks = float(input("Enter marks: "))

        student_details = (name, branch, marks)
        students[roll_no] = student_details
        print("Student added successfully!")

    elif choice == "2":
        roll_no = input("Enter roll number to delete: ")

        if roll_no in students:
            del students[roll_no]
            print("Student deleted successfully!")
        else:
            print("Student not found!")

    elif choice == "3":
        roll_no = input("Enter roll number to update: ")

        if roll_no in students:
            name = input("Enter new name: ")
            branch = input("Enter new branch: ")
            marks = float(input("Enter new marks: "))

            students[roll_no] = (name, branch, marks)
            print("Student updated successfully!")
        else:
            print("Student not found!")

    elif choice == "4":
        if students:
            print("\nStudent Records:")
            for roll_no, details in students.items():
                print("Roll Number:", roll_no)
                print("Name:", details[0])
                print("Branch:", details[1])
                print("Marks:", details[2])
                print("--------------------")
        else:
            print("No student records available.")

    elif choice == "5":
        print("Program ended.")
        break

    else:
        print("Invalid choice! Try again.")
